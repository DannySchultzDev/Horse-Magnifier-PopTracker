{
  // sets layouts for shadred items grids
  // bigger example: https://github.com/Cyb3RGER/sm_ap_tracker/blob/main/layouts/items.json
  "shared_item_grid": {
    "type": "array",
    "orientation": "vertical",
    "margin": "0,0",
    "content": [
      {
        "type": "array",
        "orientation": "horizontal",
        "margin": "0,0",
        "content": [
          {
            "type": "itemgrid",
            "background": "#202020",
            "item_margin": "10, 10",
            "h_alignment": "left",
            "rows": [
              [
                "Fisheye Lens",
                "Stretch Lens",
                "Flip Lens",
                "Portal Lens",
                "X-Ray Lens",
                "Apple",
                "Horses"
              ],
              [
                "Anti-Fisheye Lens",
                "Compress Lens",                
                "Swirl Lens",
                "Replicator Lens",
                "Color Lens",
                "Horsefly Swatter"
              ]
            ]
          }
        ]
      }
    ]
  },
  "shared_settings_grid": {
    "type": "array",
    "orientation": "vertical",
    "margin": "0,0",
    "content": [
      {
        "type": "array",
        "orientation": "horizontal",
        "margin": "0,0",
        "content": [
          {
            "type": "itemgrid",
            "background": "#202020",
            "item_margin": "10, 10",
            "h_alignment": "left",
            "rows": [
              [
                "Perfect Accuracy"
              ],
              [
                "Goal Requirement"
              ]
            ]
          }
        ]
      }
    ]
  }
}
